# Generate random secrets with: openssl rand -hex 32
APP_ENV=local
LOG_LEVEL=INFO

# Shared with the Next.js backend (sent as X-Model-Key). Required.
MODEL_API_KEY=

DATA_VERSION=dev
MODEL_VERSION=dev
REGION_CONFIG=config/regions/example.yaml

# Local PostGIS from `docker compose --profile db` (port bound to 127.0.0.1 only)
POSTGRES_DB=evaku
POSTGRES_USER=evaku
POSTGRES_PASSWORD=

SUPABASE_DB_URL=

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=evaku-maps
R2_BUCKET_PRIVATE=evaku-private

# Web app callback after a pipeline run
NEXT_BASE_URL=http://localhost:3000
PIPELINE_SECRET=

# Monitoring and data sources
HEALTHCHECKS_URL=
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=
